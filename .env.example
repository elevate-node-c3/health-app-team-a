# Application
NODE_ENV=dev
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=health_app

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: leave empty when Redis requires no password
REDIS_PASSWORD=
# Cache TTL in milliseconds
REDIS_TTL=60000

#JWT
JWT_ACCESS_EXP="15m"
JWT_ACCESS_SECRET=""
JWT_REFRESH_EXP="7d"
JWT_REFRESH_SECRET=""
