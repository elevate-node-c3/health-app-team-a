# Application
NODE_ENV=dev
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=bassel123
DB_NAME=health_app

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: leave empty when Redis requires no password
REDIS_PASSWORD=
# Cache TTL in milliseconds
REDIS_TTL=60000

# JWT
JWT_ACCESS_EXP="15m"
JWT_ACCESS_SECRET="replace-with-a-long-secret"
JWT_REFRESH_EXP="7d"
JWT_REFRESH_SECRET="replace-with-a-long-refresh-secret"

# SMTP / email verification
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@smtp.ethereal.email