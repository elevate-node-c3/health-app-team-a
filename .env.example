# Application
NODE_ENV=dev
PORT=3000

# PostgreSQL
# DB_HOST is overridden to the "postgres" Compose service name when running
# under `docker compose up`; keep it as localhost here for running the app
# directly on the host.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=health_app

# Redis
# REDIS_HOST is likewise overridden to "redis" under Docker Compose.
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: leave empty when Redis requires no password
REDIS_PASSWORD=
# Cache TTL in milliseconds
REDIS_TTL=60000

# JWT
JWT_ACCESS_EXP="15m"
JWT_ACCESS_SECRET="replace-with-a-long-secret"
JWT_REFRESH_EXP="7d"
JWT_REFRESH_SECRET="replace-with-a-long-refresh-secret"

# SMTP / email verification
SMTP_HOST=local
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM=no-reply@elevate-health-app.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# RabbitMQ
# RABBITMQ_URL is overridden to amqp://rabbitmq:5672 under Docker Compose.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=health.events

# Backend AI provider secrets and model rates (USD per million tokens)
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_INPUT_COST_PER_MILLION=
# AI_OUTPUT_COST_PER_MILLION=
# AI_MONTHLY_LIMIT=
