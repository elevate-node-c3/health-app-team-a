  "item": [
    {
      "name": "Health and Home",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/"
          }
        },
        {
          "name": "Home (guest or signed in)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/home"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"{{phone}}\",\n  \"gender\": \"{{gender}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/signup"
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/verify-email"
          }
        },
        {
          "name": "Resend email verification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/resend-verification"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Refresh session",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/refresh"
          }
        },
        {
          "name": "Logout this device",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"everywhere\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/logout"
          }
        },
        {
          "name": "Logout all devices",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"everywhere\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/logout"
          }
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/users?page=1&limit=10"
          }
        },
        {
          "name": "Begin password recovery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/forget-password"
          }
        },
        {
          "name": "Resend password recovery OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/forget-password/resend-otp"
          }
        },
        {
          "name": "Verify recovery OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/verify-otp"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Suggestions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/search/suggestions?query={{search_query}}"
          }
        },
        {
          "name": "Search doctors and specialties",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/search?query={{search_query}}&page=1&limit=10&sortBy=rating&sortOrder=DESC"
          }
        },
        {
          "name": "Search with filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/search?query={{search_query}}&genders=MALE&availability=Today&minPrice=100&maxPrice=500&rating=3&governorate=Cairo&city=Maadi&specialty={{specialty}}&sortBy=price&sortOrder=ASC"
          }
        },
        {
          "name": "Search on map (visible bounds)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/search/map?query={{search_query}}&neLat=30.15&neLng=31.40&swLat=29.95&swLng=31.15&userLat=30.0444&userLng=31.2357"
          }
        },
        {
          "name": "Search history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/search/history"
          }
        },
        {
          "name": "Clear search history",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/search/history"
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Doctor profile (guest or signed in)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/doctors/{{doctor_id}}"
          }
        },
        {
          "name": "Doctor availability for a clinic and month",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/doctors/{{doctor_id}}/availability?clinicId={{clinic_id}}&month={{availability_month}}"
          }
        }
      ]
    },
    {
      "name": "Articles",
      "item": [
        {
          "name": "List published articles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/articles?page=1&limit=10"
          }
        },
        {
          "name": "Get published article",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/articles/{{article_id}}"
          }
        }
      ]
    },
    {
      "name": "Favourites",
      "item": [
        {
          "name": "Add doctor to favourites",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/favourites/{{doctor_id}}"
          }
        },
        {
          "name": "Remove doctor from favourites",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/favourites/{{doctor_id}}"
          }
        }
      ]
    },
    {
      "name": "Payment Methods",
      "item": [
        {
          "name": "List saved payment methods",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/payment-methods"
          }
        },
        {
          "name": "Add and save test card",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holderName\": \"{{card_holder}}\",\n  \"cardNumber\": \"{{test_card_number}}\",\n  \"ccv\": \"123\",\n  \"expiry\": \"12/30\",\n  \"saveCard\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/payment-methods"
          }
        },
        {
          "name": "Edit saved payment method",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holderName\": \"{{card_holder}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/payment-methods/{{payment_method_id}}"
          }
        },
        {
          "name": "Remove saved payment method",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/payment-methods/{{payment_method_id}}"
          }
        }
      ]
    },
    {
      "name": "Appointment Booking and Payment",
      "description": "Run Create booking hold, set hold_id from its response, then Confirm payment. Keep idempotency_key unchanged for retries of that attempt; use a new key for a different attempt.",
      "item": [
        {
          "name": "Create booking hold",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctor_id}}\",\n  \"clinicId\": \"{{clinic_id}}\",\n  \"scheduledAt\": \"{{scheduled_at}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/appointments/holds"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const result = pm.response.json();",
                  "  if (result.id) pm.collectionVariables.set('hold_id', result.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm payment (reuse key on retry)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holdId\": \"{{hold_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/payment-methods/{{payment_method_id}}/confirm"
          }
        },
        {
          "name": "Check payment status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/payment-methods/attempts/{{idempotency_key}}"
          }
        },
        {
          "name": "Provider webhook (fake adapter only)",
          "description": "For local fake-provider testing, send a result already recorded by the fake adapter. A real provider must send its own signed event. The provider idempotencyKey is the server payment-attempt ID, not the client Idempotency-Key.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Provider-Signature",
                "value": "{{fake_provider_signature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"{{provider_attempt_id}}\",\n  \"providerPaymentId\": \"{{provider_payment_id}}\",\n  \"status\": \"succeeded\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/payment-provider/webhook"
          }
        }
      ]
    }
  ],
