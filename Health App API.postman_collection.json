                  "raw": "{\n  \"holdId\": \"{{hold_id}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{base_url}}/payment-methods/{{payment_method_id}}/confirm"
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"confirmed\",\n  \"paymentStatus\": \"succeeded\",\n  \"appointmentId\": \"6936f32a-1e46-4eb0-879c-cff5c035b96d\",\n  \"scheduledAt\": \"2026-10-10T09:00:00.000Z\",\n  \"doctorName\": \"Dr Mona Seed\",\n  \"clinicName\": \"Nile Clinic (seed)\",\n  \"arriveAt\": \"2026-10-10T08:45:00.000Z\",\n  \"message\": \"Your appointment has been booked successfully. On Saturday, October 10 at 9:00 AM with Dr. Dr Mona Seed. We will remind you. Please arrive 15 minutes before the appointment.\"\n}"
            }
          ]
        },
        {
          "name": "Check payment status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/payment-methods/attempts/{{idempotency_key}}"
          }
        },
        {
          "name": "Stripe webhook (payment_intent.succeeded)",
          "description": "Simulates Stripe's callback for a successful charge. Real Stripe webhooks carry this automatically — this request exists for local testing when Stripe can't reach your machine. IMPORTANT: `metadata.idempotency_key` must be the internal payment ATTEMPT's database UUID (what the server sent Stripe when charging — see StripePaymentProviderAdapter.charge), not the client-facing Idempotency-Key header value. No API response exposes that UUID; find it in the server logs (it's logged on reconciliation) or by querying the payment_attempts table directly, then set the `payment_attempt_id` variable to it. The pre-request script signs the exact body sent with {{stripe_webhook_secret}} (set to your local .env's STRIPE_WEBHOOK_SECRET) so stripe.webhooks.constructEvent on the server accepts it — that part works out of the box; only the attempt id needs manual lookup.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = JSON.stringify({",
                  "  id: 'evt_test_webhook',",
                  "  type: 'payment_intent.succeeded',",
                  "  data: {",
                  "    object: {",
                  "      id: 'pi_test_webhook',",
                  "      status: 'succeeded',",
                  "      metadata: { idempotency_key: pm.variables.get('payment_attempt_id') }",
                  "    }",
                  "  }",
                  "});",
                  "pm.request.body.raw = body;",
                  "",
                  "const secret = pm.variables.get('stripe_webhook_secret');",
                  "const timestamp = Math.floor(Date.now() / 1000);",
                  "const signedPayload = `${timestamp}.${body}`;",
                  "const hash = CryptoJS.HmacSHA256(signedPayload, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'Stripe-Signature', value: `t=${timestamp},v1=${hash}` });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_webhook\",\n  \"type\": \"payment_intent.succeeded\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_test_webhook\",\n      \"status\": \"succeeded\",\n      \"metadata\": {\n        \"idempotency_key\": \"{{payment_attempt_id}}\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/payment-provider/webhook"
          }
        }
      ]
    },
