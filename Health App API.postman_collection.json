    {
      "name": "Appointment Booking and Payment",
      "description": "Run Create booking hold, set hold_id from its response, then Confirm payment. Keep idempotency_key unchanged for retries of that attempt; use a new key for a different attempt.",
      "item": [
        {
          "name": "Create booking hold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
