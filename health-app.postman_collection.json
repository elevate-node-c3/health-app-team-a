{
  "info": {
    "name": "Health App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout (this device)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"everywhere\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Logout (all devices)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"everywhere\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Suggestions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/doctors/search/suggestions?query=Den",
              "host": ["{{base_url}}"],
              "path": ["doctors", "search", "suggestions"],
              "query": [
                {
                  "key": "query",
                  "value": "Den"
                }
              ]
            }
          }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/doctors/search?query=Sara%20Mahmoud",
              "host": ["{{base_url}}"],
              "path": ["doctors", "search"],
              "query": [
                {
                  "key": "query",
                  "value": "Sara Mahmoud"
                }
              ]
            }
          }
        },
        {
          "name": "Search history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/doctors/search/history",
              "host": ["{{base_url}}"],
              "path": ["doctors", "search", "history"]
            }
          }
        },
        {
          "name": "Clear search history",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/doctors/search/history",
              "host": ["{{base_url}}"],
              "path": ["doctors", "search", "history"]
            }
          }
        }
      ]
    }
  ]
}
