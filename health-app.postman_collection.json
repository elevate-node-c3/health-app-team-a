{
  "info": {
    "name": "Health App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "doctor_id",
      "value": "22222222-2222-4222-8222-222222222222"
    },
    {
      "key": "clinic_id",
      "value": "33333333-3333-4333-8333-333333333333"
    },
    {
      "key": "scheduled_at",
      "value": "2027-01-10T08:00:00Z"
    },
    {
      "key": "slot_hold_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout (this device)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"everywhere\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Logout (all devices)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"everywhere\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Suggestions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/doctors/search/suggestions?query=Den",
              "host": ["{{base_url}}"],
              "path": ["doctors", "search", "suggestions"],
              "query": [
                {
                  "key": "query",
                  "value": "Den"
                }
              ]
            }
          }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/doctors/search?query=Sara%20Mahmoud",
              "host": ["{{base_url}}"],
              "path": ["doctors", "search"],
              "query": [
                {
                  "key": "query",
                  "value": "Sara Mahmoud"
                }
              ]
            }
          }
        },
        {
          "name": "Search history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/doctors/search/history",
              "host": ["{{base_url}}"],
              "path": ["doctors", "search", "history"]
            }
          }
        },
        {
          "name": "Clear search history",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/doctors/search/history",
              "host": ["{{base_url}}"],
              "path": ["doctors", "search", "history"]
            }
          }
        }
      ]
    },
    {
      "name": "Slot Holds",
      "item": [
        {
          "name": "Login as patient A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.a@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login as patient B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.b@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Hold slot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  pm.collectionVariables.set('slot_hold_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctor_id}}\",\n  \"clinicId\": \"{{clinic_id}}\",\n  \"scheduledAt\": \"{{scheduled_at}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/slot-holds",
              "host": ["{{base_url}}"],
              "path": ["slot-holds"]
            }
          }
        },
        {
          "name": "Hold slot (off-grid time, 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctor_id}}\",\n  \"clinicId\": \"{{clinic_id}}\",\n  \"scheduledAt\": \"2027-01-10T08:17:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/slot-holds",
              "host": ["{{base_url}}"],
              "path": ["slot-holds"]
            }
          }
        },
        {
          "name": "Get hold",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/slot-holds/{{slot_hold_id}}",
              "host": ["{{base_url}}"],
              "path": ["slot-holds", "{{slot_hold_id}}"]
            }
          }
        },
        {
          "name": "Extend hold (3-D Secure)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/slot-holds/{{slot_hold_id}}/extend",
              "host": ["{{base_url}}"],
              "path": ["slot-holds", "{{slot_hold_id}}", "extend"]
            }
          }
        },
        {
          "name": "Release hold",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/slot-holds/{{slot_hold_id}}",
              "host": ["{{base_url}}"],
              "path": ["slot-holds", "{{slot_hold_id}}"]
            }
          }
        }
      ]
    }
  ]
}
